VITE_API_BASE_URL=http://127.0.0.1:8060
VITE_ASSET_BASE_URL=http://127.0.0.1:8060
VITE_SOCKET_URL=http://127.0.0.1:8060
VITE_READ_ONLY_MODE=false
VITE_BLOCK_SOCKET_EMIT=false
VITE_MAPBOX_TOKEN=

# Main GIS map + KPI dashboard map widget basemap source.
# true (default) = local offline PMTiles basemap, false = online CARTO tiles.
VITE_OFFLINE_MAPS_ENABLED=true

# Geo Drill-Down module (route + page). Disabled by default.
VITE_GEO_DRILLDOWN_ENABLED=false

# Microsoft SSO login (requires VITE_CLIENT_ID from Azure AD app registration)
VITE_MICROSOFT_AUTH_ENABLED=false
VITE_CLIENT_ID=

# Superset embedded dashboards (no trailing slash on UI origin)
VITE_SUPERSET_UI_ORIGIN=http://127.0.0.1:8088
VITE_SUPERSET_GUEST_TOKEN_URL=http://127.0.0.1:8060/api/superset/guest-token
# Superset dashboard UUID opened from the GIS map's cell Charts popup.
# Unset = default Gabon/Malawi dashboard. Telco360: 9615446e-0ccd-4a06-8c1f-090912f596fc
# VITE_SUPERSET_DASHBOARD_UUID=
# Optional per-technology override (Telco360 only): a cell's technology (4G/5G) picks its
# dashboard; uuid + its own cell_name native filter id are set as a pair. Unset = above.
# VITE_SUPERSET_DASHBOARD_UUID_5G=9615446e-0ccd-4a06-8c1f-090912f596fc
# VITE_NATIVE_FILTER_ID_5G=NATIVE_FILTER-5GXAdVS4DX44_zQDXa4z4
# VITE_SUPERSET_DASHBOARD_UUID_4G=21efbbdc-07bb-4b54-860f-fb5c801722bf
# VITE_NATIVE_FILTER_ID_4G=NATIVE_FILTER-fJOAzoI4J37DEC3JlAd2d

# Vite dev-server allowed hostnames (vite.config.js server.allowedHosts).
# Comma-separated or array style, e.g. ['dyserver', '192.168.0.172', "dataplus.live"]. Unset = Vite default (localhost only).
ALLOWED_HOSTS=
