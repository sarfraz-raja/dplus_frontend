VITE_API_BASE_URL=http://127.0.0.1:8060
VITE_ASSET_BASE_URL=http://127.0.0.1:8060
VITE_SOCKET_URL=http://127.0.0.1:8060
VITE_READ_ONLY_MODE=false
VITE_BLOCK_SOCKET_EMIT=false
VITE_MAPBOX_TOKEN=

# Main GIS map + KPI dashboard map widget basemap source.
# true (default) = local offline PMTiles basemap, false = online CARTO tiles.
VITE_OFFLINE_MAPS_ENABLED=true

# Geo Drill-Down module (route + page). Disabled by default.
VITE_GEO_DRILLDOWN_ENABLED=false

# Microsoft SSO login (requires VITE_CLIENT_ID from Azure AD app registration)
VITE_MICROSOFT_AUTH_ENABLED=false
VITE_CLIENT_ID=

# Superset embedded dashboards (no trailing slash on UI origin)
VITE_SUPERSET_UI_ORIGIN=http://127.0.0.1:8088
VITE_SUPERSET_GUEST_TOKEN_URL=http://127.0.0.1:8060/api/superset/guest-token
